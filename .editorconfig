# EditorConfig is awesome: https://editorconfig.org
# Top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python uses 4-space indentation (PEP 8)
[*.py]
indent_size = 4

# Makefiles require literal tabs
[Makefile]
indent_style = tab

# Don't trim trailing whitespace in Markdown (two trailing spaces = hard line break)
[*.md]
trim_trailing_whitespace = false
