# Dermalens Production Environment Variables
# Copy this to .env and update with your production values

# Database Configuration
DATABASE_URL=postgresql://dermalens-user:your-password@/dermalens?host=/cloudsql/dermalens-production:us-central1:dermalens-db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-production-supabase-key
SUPABASE_SERVICE_ROLE_KEY=your-production-supabase-service-role-key

# Elasticsearch Configuration
ELASTICSEARCH_URL=https://your-cluster.es.us-central1.gcp.cloud.es.io:9243
ELASTICSEARCH_API_KEY=your-production-elasticsearch-api-key
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
ELASTICSEARCH_SSL_VERIFY=true

# Fivetran Configuration
FIVETRAN_API_KEY=your-production-fivetran-api-key
FIVETRAN_API_SECRET=your-production-fivetran-api-secret
FIVETRAN_GROUP_ID=your-production-group-id

# Google Cloud Configuration
GCP_PROJECT_ID=dermalens-production
GOOGLE_APPLICATION_CREDENTIALS=/app/production-key.json
BIGQUERY_DATASET=skincare_data
GCS_BUCKET=dermalens-production-data
GCS_BUCKET_REGION=us-central1

# Google Gemini Configuration
GEMINI_API_KEY=your-production-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_ENABLED=true

# OpenAI Configuration (fallback)
OPENAI_API_KEY=your-production-openai-api-key
OPENAI_MODEL=gpt-4-vision-preview
OPENAI_MAX_TOKENS=1000
OPENAI_ENABLED=false

# Google Search Configuration
GOOGLE_SEARCH_API_KEY=your-production-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-production-search-engine-id

# CORS Configuration
ALLOWED_ORIGINS=https://dermalens-frontend-xxx-uc.a.run.app,https://dermalens.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Security Configuration
JWT_SECRET_KEY=your-production-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/dermalens.log

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_ELASTICSEARCH=true
ENABLE_FIVETRAN=true
ENABLE_GOOGLE_CLOUD=true
ENABLE_MONITORING=true

# Performance Configuration
MAX_WORKERS=4
WORKER_TIMEOUT=300
KEEP_ALIVE_TIMEOUT=5

# Cache Configuration
REDIS_URL=redis://your-redis-instance:6379
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg
UPLOAD_DIRECTORY=/app/uploads

# AI Model Configuration
MODEL_PATH=/app/models/enhanced_skin_classifier.pth
MODEL_CONFIDENCE_THRESHOLD=0.3
MODEL_BATCH_SIZE=32
MODEL_DEVICE=cuda

# Elasticsearch Index Configuration
ELASTICSEARCH_INDEX_PREFIX=dermalens_prod
ELASTICSEARCH_SHARDS=1
ELASTICSEARCH_REPLICAS=1
ELASTICSEARCH_REFRESH_INTERVAL=1s

# BigQuery Configuration
BIGQUERY_DATASET_LOCATION=US
BIGQUERY_TABLE_EXPIRATION_MS=31536000000  # 1 year

# Cloud Storage Configuration
GCS_PUBLIC_URL=https://storage.googleapis.com
GCS_SIGNED_URL_EXPIRATION=3600  # 1 hour

# Error Handling
SENTRY_DSN=your-sentry-dsn
ERROR_REPORTING_ENABLED=true
ERROR_REPORTING_SAMPLE_RATE=0.1

# Development/Production Flag
ENVIRONMENT=production
DEBUG=false
TESTING=false
