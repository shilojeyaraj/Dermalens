# =============================================================================
# NEW ENHANCED CONFIGURATION
# =============================================================================

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_REGION=us-central1

# Vertex AI Configuration
VERTEX_AI_ENABLED=True
VERTEX_AI_ENDPOINT=projects/your-google-cloud-project-id/locations/us-central1/endpoints/skin-analysis
VERTEX_AI_CACHE_ENABLED=True
VERTEX_AI_STREAMING_ENABLED=True

# Multi-Model Configuration
ENSEMBLE_ENABLED=True
CONDITION_CLASSIFIER_WEIGHT=0.4
SEVERITY_ANALYZER_WEIGHT=0.3
SKIN_TYPE_DETECTOR_WEIGHT=0.3

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=True
METRICS_ENDPOINT=projects/your-google-cloud-project-id/locations/us-central1/endpoints/metrics

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================

# Redis Configuration (for intelligent caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL_ENABLED=False

# Cache TTL Settings (in seconds)
CACHE_TTL_ANALYSIS_RESULTS=3600
CACHE_TTL_PRODUCT_RECOMMENDATIONS=1800
CACHE_TTL_USER_PROFILES=7200
CACHE_TTL_SIMILARITY_CACHE=86400
CACHE_TTL_HOT_DATA=300

# Cache Configuration
CACHE_MAX_SIZE=1000
CACHE_CLEANUP_INTERVAL=3600
CACHE_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# AI RECOMMENDATION ENGINE CONFIGURATION
# =============================================================================

# Recommendation Strategies
RECOMMENDATION_STRATEGY_COLLABORATIVE=0.3
RECOMMENDATION_STRATEGY_CONTENT_BASED=0.4
RECOMMENDATION_STRATEGY_HYBRID=0.3

# Recommendation Limits
MAX_RECOMMENDATIONS_PER_REQUEST=10
MAX_RECOMMENDATIONS_PER_CONDITION=5
MAX_RECOMMENDATIONS_PER_USER=20

# Recommendation Quality Thresholds
MIN_RECOMMENDATION_CONFIDENCE=0.5
MIN_RECOMMENDATION_RATING=3.0
MIN_RECOMMENDATION_REVIEW_COUNT=10

# =============================================================================
# PERFORMANCE MONITORING CONFIGURATION
# =============================================================================

# Prometheus Configuration
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=8001
PROMETHEUS_PATH=/metrics

# Google Cloud Monitoring
GOOGLE_CLOUD_MONITORING_ENABLED=True
GOOGLE_CLOUD_MONITORING_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_MONITORING_REGION=us-central1

# Performance Thresholds
MAX_ANALYSIS_LATENCY=5.0
MAX_RECOMMENDATION_LATENCY=3.0
MAX_CACHE_LATENCY=0.1
MIN_SERVICE_HEALTH_SCORE=0.8

# Monitoring Intervals (in seconds)
HEALTH_CHECK_INTERVAL=30
METRICS_FLUSH_INTERVAL=60
PERFORMANCE_ANALYSIS_INTERVAL=300

# =============================================================================
# STREAMING CONFIGURATION
# =============================================================================

# Streaming Analysis
STREAMING_ENABLED=True
STREAMING_CHUNK_SIZE=1024
STREAMING_TIMEOUT=30
STREAMING_MAX_CONNECTIONS=100

# Real-time Updates
REALTIME_UPDATES_ENABLED=True
REALTIME_UPDATE_INTERVAL=1
REALTIME_MAX_UPDATES=100

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# API Security
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
API_MAX_REQUESTS_PER_USER=1000

# Authentication
JWT_REFRESH_TOKEN_EXPIRATION=7
JWT_ACCESS_TOKEN_EXPIRATION=1
JWT_ALGORITHM=HS256

# Data Privacy
DATA_ENCRYPTION_ENABLED=True
DATA_RETENTION_DAYS=365
DATA_ANONYMIZATION_ENABLED=True

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Levels
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=logs/dermalens.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Log Categories
LOG_ANALYSIS_ENABLED=True
LOG_RECOMMENDATIONS_ENABLED=True
LOG_PERFORMANCE_ENABLED=True
LOG_ERRORS_ENABLED=True
LOG_DEBUG_ENABLED=False

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development Mode
DEVELOPMENT_MODE=True
DEBUG_LOGGING=True
MOCK_SERVICES=False
TEST_DATA_ENABLED=False

# Testing
TEST_MODE=False
TEST_DATA_PATH=test_data/
TEST_IMAGES_PATH=test_data/images/
TEST_VIDEOS_PATH=test_data/videos/

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

