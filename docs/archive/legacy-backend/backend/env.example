# 🔬 Dermalens Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# GOOGLE GEMINI CONFIGURATION (Required)
# =============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_ENABLED=true

# =============================================================================
# ELASTICSEARCH CONFIGURATION (Required for Production)
# =============================================================================
# For local development (Docker)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_SSL_VERIFY=false

# For production (Elastic Cloud)
# ELASTICSEARCH_URL=https://your-cluster.es.us-central1.gcp.cloud.es.io:9243
# ELASTICSEARCH_API_KEY=your-elasticsearch-api-key
# ELASTICSEARCH_SSL_VERIFY=true

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# GOOGLE SEARCH CONFIGURATION (Required)
# =============================================================================
# Get these from Google Custom Search API
GOOGLE_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id

# =============================================================================
# FIVETRAN CONFIGURATION (Optional - for Production)
# =============================================================================
# Get these from your Fivetran account
FIVETRAN_API_KEY=your-fivetran-api-key
FIVETRAN_API_SECRET=your-fivetran-api-secret
FIVETRAN_GROUP_ID=your-group-id

# =============================================================================
# GOOGLE CLOUD CONFIGURATION (Optional - for Production)
# =============================================================================
# For production deployment
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
BIGQUERY_DATASET=skincare_data
GCS_BUCKET=dermalens-production-images

# =============================================================================
# OPENAI CONFIGURATION (Fallback - Optional)
# =============================================================================
# Keep as fallback if Gemini is not available
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_ENABLED=false

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application settings
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database settings
DATABASE_URL=postgresql://postgres:password@localhost:5432/dermalens

# Security settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# File upload settings
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=10

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Sentry for error tracking (optional)
SENTRY_DSN=your-sentry-dsn

# Google Cloud Logging (for production)
GOOGLE_CLOUD_LOGGING_PROJECT_ID=your-gcp-project-id

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development mode
DEVELOPMENT_MODE=true
MOCK_AI_RESPONSES=false
USE_SAMPLE_DATA=true

# Testing
TEST_MODE=false
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/dermalens_test

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Email service (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SMS service (optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_AI_ANALYSIS=true
ENABLE_PRODUCT_SEARCH=true
ENABLE_USER_PROFILES=true
ENABLE_SKINCARE_ROUTINES=true
ENABLE_GOOGLE_SEARCH=true
ENABLE_ELASTICSEARCH=true
ENABLE_FIVETRAN=false

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Caching
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600  # 1 hour

# Background tasks
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================
# Backup settings
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# =============================================================================
# COMPLIANCE AND SECURITY
# =============================================================================
# GDPR compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=365

# Security headers
SECURE_HEADERS=true
HSTS_ENABLED=true
CSP_ENABLED=true

# =============================================================================
# ANALYTICS AND TRACKING
# =============================================================================
# Google Analytics (optional)
GA_TRACKING_ID=your-ga-tracking-id

# Mixpanel (optional)
MIXPANEL_TOKEN=your-mixpanel-token

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Push notifications (optional)
FCM_SERVER_KEY=your-fcm-server-key

# Webhook notifications
WEBHOOK_URL=your-webhook-url
WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# CUSTOM INTEGRATIONS
# =============================================================================
# Custom API endpoints
CUSTOM_API_BASE_URL=https://api.example.com
CUSTOM_API_KEY=your-custom-api-key

# Third-party integrations
STRIPE_SECRET_KEY=your-stripe-secret-key
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
