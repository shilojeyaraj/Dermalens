@app.post("/analyze-skin-multi-angle")
async def analyze_skin_multi_angle(
    files: List[UploadFile] = File(...),
    current_user_id: str = Depends(get_current_user_id)
):
    """Analyze skin conditions from multiple angles (center, left, right) for comprehensive assessment"""
    try:
        # Parse uploaded files
        center_images = []
        left_images = []
        right_images = []
        
        for file in files:
            content = await file.read()
            
            # Validate file type
            if not file.content_type or not file.content_type.startswith('image/'):
                raise HTTPException(status_code=400, detail="All files must be images")
            
            # Categorize based on filename
            filename = file.filename.lower() if file.filename else ""
            if "center" in filename:
                center_images.append(content)
            elif "left" in filename:
                left_images.append(content)
            elif "right" in filename:
                right_images.append(content)
        
        if not center_images or not left_images or not right_images:
            raise HTTPException(
                status_code=400,
                detail="Must provide images from all three angles: center, left, and right"
            )
        
        # Analyze each angle's best image
        def get_best_image(images):
            """Select best quality image from a batch"""
            return images[0] if images else None
        
        center_analysis = skin_analysis_service.analyze_skin_image(get_best_image(center_images))
        left_analysis = skin_analysis_service.analyze_skin_image(get_best_image(left_images))
        right_analysis = skin_analysis_service.analyze_skin_image(get_best_image(right_images))
        
        # Combine analyses
        all_conditions = set()
        for analysis in [center_analysis, left_analysis, right_analysis]:
            if analysis["success"]:
                all_conditions.update(analysis.get("detected_conditions", []))
        
        detected_conditions = list(all_conditions)
        
        # Get user's skin profile
        skin_profile_result = await db_manager.get_skin_profile(current_user_id)
        user_skin_profile = normalize_skin_profile(
            skin_profile_result.get("data") if skin_profile_result.get("success") else {}
        )
        
        # Get product recommendations
        combined_analysis = {
            "center": center_analysis.get("analysis_results", {}),
            "left": left_analysis.get("analysis_results", {}),
            "right": right_analysis.get("analysis_results", {})
        }
        
        elasticsearch_result = elasticsearch_service.get_recommendations(
            user_skin_profile or {},
            combined_analysis,
            limit=10
        )
        
        # Get additional products from Google Search
        google_products = await search_real_skincare_products(detected_conditions, user_skin_profile)
        
        # Combine recommendations
        all_products = []
        if elasticsearch_result["success"]:
            all_products.extend(elasticsearch_result["recommendations"])
        all_products.extend(google_products)
        
        # Get user's basic profile for comprehensive analysis
        user_profile_result = await db_manager.get_user_profile(current_user_id)
        user_profile = normalize_user_profile(
            user_profile_result.get("data") if user_profile_result.get("success") else {}
        )
        
        # Combine profile data with image analysis
        comprehensive_profile = {
            **(user_skin_profile or {}),
            **(user_profile or {}),
            "image_analysis": combined_analysis,
            "detected_conditions": detected_conditions,
            "analysis_type": "multi_angle_with_profile"
        }
        
        # Generate comprehensive AI report considering both images AND profile
        from gemini_analysis_service import get_gemini_service
        gemini_service = get_gemini_service(GEMINI_API_KEY)
        
        multi_angle_report = gemini_service.generate_personalized_report(
            user_profile=comprehensive_profile,
            analysis_results=combined_analysis,
            detected_conditions=detected_conditions
        )
        
        # Add angle-specific insights
        angle_insights = {
            "center_analysis": center_analysis.get("analysis_results", {}),
            "left_analysis": left_analysis.get("analysis_results", {}),
            "right_analysis": right_analysis.get("analysis_results", {}),
            "profile_integration": {
                "skin_type": user_skin_profile.get('skin_type', 'unknown'),
                "age": user_profile.get('age', 'unknown'),
                "concerns": user_skin_profile.get('skin_concerns', []),
                "lifestyle_factors": user_profile.get('lifestyle_factors', [])
            },
            "combined_assessment": f"Comprehensive analysis from 3 angles + profile reveals: {', '.join(detected_conditions)}"
        }
        
        # Generate routine considering both image analysis AND profile
        routine = gemini_service.generate_skincare_routine(
            conditions=detected_conditions,
            products=all_products,
            user_profile=comprehensive_profile
        )
        
        # Calculate enhanced health score considering both image analysis and profile
        base_health_score = (
            (center_analysis.get("skin_health_score", 0) +
             left_analysis.get("skin_health_score", 0) +
             right_analysis.get("skin_health_score", 0)) / 3
        )
        
        # Adjust score based on profile factors
        profile_adjustment = 0
        if user_skin_profile.get('skin_type') == 'normal':
            profile_adjustment += 0.05
        if user_profile.get('age', 25) < 30:
            profile_adjustment += 0.05
        if not user_skin_profile.get('skin_concerns'):
            profile_adjustment += 0.05
        
        final_health_score = min(base_health_score + profile_adjustment, 1.0)
        
        return {
            "success": True,
            "analysis_type": "multi_angle_with_profile",
            "angle_analysis": angle_insights,
            "detected_conditions": detected_conditions,
            "recommended_products": all_products,
            "skincare_routine": routine,
            "ai_report": multi_angle_report,
            "skin_health_score": final_health_score,
            "analysis_timestamp": datetime.now().isoformat(),
            "user_skin_profile": user_skin_profile,
            "user_profile": user_profile,
            "comprehensive_profile": comprehensive_profile,
            "images_analyzed": {
                "center": len(center_images),
                "left": len(left_images),
                "right": len(right_images)
            },
            "analysis_notes": {
                "image_analysis_contribution": f"Detected {len(detected_conditions)} conditions from 3-angle scan",
                "profile_enhancement": f"Enhanced with {user_skin_profile.get('skin_type', 'unknown')} skin type and age {user_profile.get('age', 'unknown')}",
                "recommendation_basis": "Combined visual analysis + personal profile for maximum personalization"
            }
        }
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Multi-angle skin analysis failed: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Multi-angle analysis failed: {str(e)}")

@app.post("/generate-profile-recommendations")
async def generate_profile_recommendations(
    current_user_id: str = Depends(get_current_user_id)
):
    """Generate skincare recommendations based on user profile without image analysis"""
    try:
        # Get user's skin profile
        skin_profile_result = await db_manager.get_skin_profile(current_user_id)
        user_skin_profile = normalize_skin_profile(
            skin_profile_result.get("data") if skin_profile_result.get("success") else {}
        )
        
        # Get user's basic profile
        user_profile_result = await db_manager.get_user_profile(current_user_id)
        user_profile = normalize_user_profile(
            user_profile_result.get("data") if user_profile_result.get("success") else {}
        )
        
        # Generate recommendations based on profile
        skin_type = user_skin_profile.get('skin_type', 'normal')
        age = user_profile.get('age', 25)
        concerns = user_skin_profile.get('skin_concerns', [])
        
        # Basic product recommendations based on skin type
        base_products = []
        
        if skin_type in ['oily', 'combination']:
            base_products.extend([
                {
                    "name": "Oil-Free Foaming Cleanser",
                    "category": "Cleanser",
                    "price": "18.99",
                    "description": "Gentle foaming cleanser for oily skin"
                },
                {
                    "name": "Lightweight Oil-Free Moisturizer",
                    "category": "Moisturizer",
                    "price": "24.50",
                    "description": "Non-comedogenic moisturizer"
                }
            ])
        elif skin_type in ['dry', 'sensitive']:
            base_products.extend([
                {
                    "name": "Creamy Hydrating Cleanser",
                    "category": "Cleanser", 
                    "price": "16.99",
                    "description": "Gentle cream cleanser for dry skin"
                },
                {
                    "name": "Rich Hydrating Moisturizer",
                    "category": "Moisturizer",
                    "price": "28.75",
                    "description": "Intensive hydration for dry skin"
                }
            ])
        else:  # normal
            base_products.extend([
                {
                    "name": "Gentle Daily Cleanser",
                    "category": "Cleanser",
                    "price": "15.99", 
                    "description": "Balanced cleanser for normal skin"
                },
                {
                    "name": "Daily Hydrating Moisturizer",
                    "category": "Moisturizer",
                    "price": "22.50",
                    "description": "Lightweight daily moisturizer"
                }
            ])
        
        # Add sunscreen (essential for all)
        base_products.append({
            "name": "Broad Spectrum SPF 30",
            "category": "Sunscreen",
            "price": "18.75",
            "description": "Daily sun protection for all skin types"
        })
        
        # Add age-specific recommendations
        if age >= 30:
            base_products.append({
                "name": "Anti-Aging Serum",
                "category": "Serum",
                "price": "45.00",
                "description": "Targeted anti-aging treatment"
            })
        
        # Add concern-specific products
        concern_products = []
        for concern in concerns:
            if 'acne' in concern.lower():
                concern_products.append({
                    "name": "Salicylic Acid Treatment",
                    "category": "Treatment",
                    "price": "19.99",
                    "description": "Targeted acne treatment"
                })
            elif 'wrinkle' in concern.lower() or 'aging' in concern.lower():
                concern_products.append({
                    "name": "Retinol Night Cream",
                    "category": "Night Cream",
                    "price": "38.50",
                    "description": "Advanced anti-aging treatment"
                })
            elif 'dark' in concern.lower() or 'spot' in concern.lower():
                concern_products.append({
                    "name": "Vitamin C Brightening Serum",
                    "category": "Serum",
                    "price": "32.00",
                    "description": "Brightening and spot treatment"
                })
        
        all_products = base_products + concern_products[:3]  # Limit to 3 concern-specific products
        
        # Generate AI routine using Gemini
        from gemini_analysis_service import get_gemini_service
        gemini_service = get_gemini_service(GEMINI_API_KEY)
        
        # Create a basic analysis structure for Gemini
        basic_analysis = {
            "skin_type": skin_type,
            "age": age,
            "concerns": concerns,
            "profile_based": True
        }
        
        ai_report = gemini_service.generate_personalized_report(
            user_profile=user_skin_profile,
            analysis_results=basic_analysis,
            detected_conditions=concerns or ['general_care']
        )
        
        routine = gemini_service.generate_skincare_routine(
            conditions=concerns or ['general_care'],
            products=all_products,
            user_profile=user_skin_profile
        )
        
        # Calculate basic health score
        health_score = 0.8  # Base score for profile-based
        if age < 25:
            health_score += 0.1
        if skin_type == 'normal':
            health_score += 0.05
        if not concerns:
            health_score += 0.05
        
        return {
            "success": True,
            "analysis_type": "profile_based",
            "detected_conditions": concerns or ['general_care'],
            "recommended_products": all_products,
            "skincare_routine": routine,
            "ai_report": ai_report,
            "skin_health_score": min(health_score, 1.0),
            "analysis_timestamp": datetime.now().isoformat(),
            "user_skin_profile": user_skin_profile,
            "images_analyzed": {
                "center": 0,
                "left": 0,
                "right": 0
            },
            "profile_analysis": {
                "skin_type": skin_type,
                "age": age,
                "concerns": concerns,
                "recommendation_basis": "User profile and skin type analysis"
            }
        }
        
    except Exception as e:
        logger.error(f"Profile-based recommendations failed: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Profile analysis failed: {str(e)}")

@app.get("/products/search")
async def search_products(
    q: str = Query(..., description="Search query"),
    category: str = Query(None, description="Product category filter"),
    brand: str = Query(None, description="Brand filter"),
    min_price: float = Query(None, description="Minimum price"),
    max_price: float = Query(None, description="Maximum price"),
    skin_type: str = Query(None, description="Skin type filter"),
    rating_min: float = Query(None, description="Minimum rating"),
    limit: int = Query(20, description="Number of results")
):
    """Search for real skincare products with filters"""
    try:
        # Get the real product search service
        product_search_service = get_real_product_search_service(
            GOOGLE_WEB_SEARCH_API_KEY, 
            GOOGLE_SEARCH_ENGINE_ID
        )
        
        # Create search conditions from query
        conditions = [q] if q else []
        
        # Search for products
        products = await product_search_service.search_skincare_products(
            conditions=conditions,
            skin_type=skin_type or 'normal',
            limit=limit
        )
        
        # Apply filters
        filtered_products = []
        for product in products:
            # Category filter
            if category and category.lower() not in product.get('category', '').lower():
                continue
            
            # Brand filter
            if brand and brand.lower() not in product.get('brand', '').lower():
                continue
            
            # Price filters
            try:
                price_str = product.get('price', '').replace('$', '').replace(',', '')
                price = float(price_str) if price_str else 0
                
                if min_price and price < min_price:
                    continue
                if max_price and price > max_price:
                    continue
            except (ValueError, TypeError):
                pass  # Skip price filtering if price is invalid
            
            # Rating filter
            rating = product.get('rating', 0)
            if rating_min and rating < rating_min:
                continue
            
            filtered_products.append(product)
        
        return {
            "success": True,
            "products": filtered_products[:limit],
            "total": len(filtered_products),
            "filters_applied": {
                "category": category,
                "brand": brand,
                "min_price": min_price,
                "max_price": max_price,
                "skin_type": skin_type,
                "rating_min": rating_min
            }
        }
        
    except Exception as e:
        logger.error(f"Product search error: {str(e)}")
        return {
            "success": False,
            "error": str(e),
            "products": []
        }

@app.get("/products/categories")
async def get_product_categories():
    """Get available product categories"""
    categories = [
        "Cleanser",
        "Moisturizer", 
        "Serum",
        "Sunscreen",
        "Toner",
        "Exfoliant",
        "Eye Cream",
        "Face Mask",
        "Treatment"
    ]
    return {"categories": categories}

@app.get("/products/trending")
async def get_trending_products():
    """Get trending skincare products"""
    try:
        # Get trending products using popular search terms
        trending_conditions = [
            "best skincare 2024",
            "trending skincare products",
            "popular facial cleanser",
            "top rated moisturizer",
            "viral skincare"
        ]
        
        product_search_service = get_real_product_search_service(
            GOOGLE_WEB_SEARCH_API_KEY, 
            GOOGLE_SEARCH_ENGINE_ID
        )
        
        trending_products = await product_search_service.search_skincare_products(
            conditions=trending_conditions,
            skin_type='normal',
            limit=10
        )
        
        return {
            "success": True,
            "trending_products": trending_products
        }
        
    except Exception as e:
        logger.error(f"Trending products error: {str(e)}")
        return {
            "success": False,
            "error": str(e),
            "trending_products": []
        }

