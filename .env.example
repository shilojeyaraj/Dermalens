# =============================================================================
# Dermalens — Environment Variables (EXAMPLE)
# =============================================================================
# Copy this file to `.env` and fill in your own values.
# NEVER commit a real `.env` — it is git-ignored.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Next.js) — variables prefixed NEXT_PUBLIC_ are exposed to the browser
# -----------------------------------------------------------------------------
# Base URL of the backend API (FastAPI / Cloud Run).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (public, browser-safe values only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# App metadata
NEXT_PUBLIC_APP_NAME=Dermalens
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags (true/false)
NEXT_PUBLIC_ENABLE_AI_ANALYSIS=true
NEXT_PUBLIC_ENABLE_PRODUCT_SEARCH=true

# Optional analytics
# NEXT_PUBLIC_GA_TRACKING_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Backend (FastAPI — apps/api) — SERVER-SIDE ONLY, never expose these
# -----------------------------------------------------------------------------
# Server
API_HOST=0.0.0.0
PORT=8000
DEBUG=false
JWT_SECRET=change-me-to-a-long-random-string

# Supabase (server-side keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Google AI / Gemini / Vertex AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_ENABLED=true
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
VERTEX_AI_ENABLED=false

# Google Programmable Search (product search)
GOOGLE_SEARCH_ENABLED=true
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id

# Elasticsearch (product index)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
# ELASTICSEARCH_API_KEY=

# Optional: OpenAI fallback
# OPENAI_API_KEY=
# OPENAI_ENABLED=false
