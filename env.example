# 🔬 Dermalens Frontend Environment Configuration
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# API CONFIGURATION (Required)
# =============================================================================
# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# For production
# NEXT_PUBLIC_API_URL=https://dermalens-backend-xxx-uc.a.run.app

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# GOOGLE SERVICES CONFIGURATION (Optional)
# =============================================================================
# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=your-ga-tracking-id

# Google Maps (if using location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
NEXT_PUBLIC_ENABLE_AI_ANALYSIS=true
NEXT_PUBLIC_ENABLE_PRODUCT_SEARCH=true
NEXT_PUBLIC_ENABLE_USER_PROFILES=true
NEXT_PUBLIC_ENABLE_SKINCARE_ROUTINES=true
NEXT_PUBLIC_ENABLE_GOOGLE_SEARCH=true
NEXT_PUBLIC_ENABLE_ELASTICSEARCH=true

# =============================================================================
# UI CONFIGURATION
# =============================================================================
# Theme settings
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_PRIMARY_COLOR=#3b82f6
NEXT_PUBLIC_SECONDARY_COLOR=#8b5cf6

# Brand settings
NEXT_PUBLIC_APP_NAME=Dermalens
NEXT_PUBLIC_APP_DESCRIPTION=AI-Powered Skincare Analysis Platform
NEXT_PUBLIC_APP_URL=https://dermalens.com

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development mode
NODE_ENV=development
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_MOCK_API=false

# Testing
NEXT_PUBLIC_TEST_MODE=false
NEXT_PUBLIC_TEST_USER_ID=test-user-123

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Image optimization
NEXT_PUBLIC_IMAGE_QUALITY=80
NEXT_PUBLIC_IMAGE_SIZES=640,750,828,1080,1200,1920,2048

# Caching
NEXT_PUBLIC_CACHE_TTL=3600
NEXT_PUBLIC_STALE_WHILE_REVALIDATE=86400

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Content Security Policy
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_CSP_REPORT_URI=https://your-domain.com/csp-report

# HTTPS enforcement
NEXT_PUBLIC_FORCE_HTTPS=false

# =============================================================================
# ANALYTICS AND TRACKING
# =============================================================================
# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# Hotjar
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Email notifications
NEXT_PUBLIC_EMAIL_ENABLED=true
NEXT_PUBLIC_EMAIL_FROM=noreply@dermalens.com

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Stripe (for payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# =============================================================================
# CUSTOM INTEGRATIONS
# =============================================================================
# Custom API endpoints
NEXT_PUBLIC_CUSTOM_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_CUSTOM_API_KEY=your-custom-api-key

# Third-party widgets
NEXT_PUBLIC_CHAT_WIDGET_ID=your-chat-widget-id
NEXT_PUBLIC_SUPPORT_EMAIL=support@dermalens.com

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Logging level
NEXT_PUBLIC_LOG_LEVEL=info

# =============================================================================
# COMPLIANCE AND PRIVACY
# =============================================================================
# GDPR compliance
NEXT_PUBLIC_GDPR_ENABLED=true
NEXT_PUBLIC_COOKIE_CONSENT=true

# Privacy settings
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://dermalens.com/privacy
NEXT_PUBLIC_TERMS_OF_SERVICE_URL=https://dermalens.com/terms

# =============================================================================
# LOCALIZATION
# =============================================================================
# Default language
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es,fr,de,it,pt,ja,ko,zh

# Timezone
NEXT_PUBLIC_DEFAULT_TIMEZONE=UTC

# =============================================================================
# CUSTOMIZATION
# =============================================================================
# Custom CSS variables
NEXT_PUBLIC_CUSTOM_CSS_VARS={"--primary-color":"#3b82f6","--secondary-color":"#8b5cf6"}

# Custom fonts
NEXT_PUBLIC_CUSTOM_FONTS=Inter,Roboto,Open Sans

# =============================================================================
# EXPERIMENTAL FEATURES
# =============================================================================
# Beta features
NEXT_PUBLIC_BETA_FEATURES_ENABLED=false
NEXT_PUBLIC_EXPERIMENTAL_AI_MODEL=false

# A/B testing
NEXT_PUBLIC_AB_TESTING_ENABLED=false
NEXT_PUBLIC_AB_TEST_VARIANT=control

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
# Build settings
NEXT_PUBLIC_BUILD_ID=development
NEXT_PUBLIC_BUILD_TIMESTAMP=2024-01-15T10:30:00Z

# CDN settings
NEXT_PUBLIC_CDN_URL=https://cdn.dermalens.com
NEXT_PUBLIC_STATIC_URL=https://static.dermalens.com

# =============================================================================
# SOCIAL MEDIA
# =============================================================================
# Social media links
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/dermalens
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/dermalens
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/dermalens
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/dermalens

# Social sharing
NEXT_PUBLIC_SOCIAL_SHARING_ENABLED=true
NEXT_PUBLIC_OG_IMAGE_URL=https://dermalens.com/og-image.jpg

# =============================================================================
# SUPPORT AND HELP
# =============================================================================
# Support settings
NEXT_PUBLIC_SUPPORT_ENABLED=true
NEXT_PUBLIC_HELP_CENTER_URL=https://help.dermalens.com
NEXT_PUBLIC_FAQ_URL=https://dermalens.com/faq

# Contact information
NEXT_PUBLIC_CONTACT_EMAIL=hello@dermalens.com
NEXT_PUBLIC_CONTACT_PHONE=+1-555-0123
